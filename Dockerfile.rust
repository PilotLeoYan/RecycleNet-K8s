# ==============================================================================
# RecycleNet High-Performance Rust Microservice Dockerfile
# Ultra-lightweight multi-stage build (< 50MB runtime footprint)
# Zero-trust security: unprivileged non-root execution (UID 10001)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Rust Builder
# ------------------------------------------------------------------------------
FROM rust:1.85-slim-bookworm AS builder

# Install build essentials and SSL libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Download ONNX Runtime C dynamic library for Linux x86_64
ARG ORT_VERSION=1.20.1
RUN mkdir -p /tmp/ort && \
    curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-${ORT_VERSION}.tgz" | \
    tar -xz --strip-components=1 -C /tmp/ort && \
    cp /tmp/ort/lib/libonnxruntime.so* /usr/lib/ && \
    rm -rf /tmp/ort

# Copy Cargo manifests and source code
COPY rust_inference/Cargo.toml rust_inference/Cargo.lock* ./
COPY rust_inference/src/ ./src/

# Compile optimized release binary
ENV ORT_DYLIB_PATH=/usr/lib/libonnxruntime.so
RUN cargo build --release

# Allow selecting 'large' or 'small' MobileNetV3 ONNX model at build time
ARG MODEL_VARIANT=large

# Prepare model artifacts
RUN mkdir -p /app/models && \
    curl -fsSL "https://huggingface.co/LeoYan/recyclenet-mobilenetv3/resolve/main/recyclenet-${MODEL_VARIANT}.onnx" -o /app/models/recyclenet.onnx && \
    curl -fsSL "https://huggingface.co/LeoYan/recyclenet-mobilenetv3/resolve/main/classes_mapping.json" -o /app/models/classes_mapping.json

# ------------------------------------------------------------------------------
# Stage 2: Minimal Distroless/Slim Runtime
# ------------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

# Install minimal certificates for external telemetry or outgoing HTTPS
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged system user for zero-trust security (appuser, UID 10001)
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -s /bin/false --no-create-home appuser

WORKDIR /app

# Copy ONNX Runtime shared library
COPY --from=builder /usr/lib/libonnxruntime.so* /usr/lib/

# Copy compiled Rust microservice binary and models
COPY --from=builder /app/target/release/rust_inference /app/rust_inference
COPY --from=builder /app/models /app/models

# Set file ownership to non-root appuser
RUN chown -R appuser:appuser /app

# Configuration environment variables
ENV PORT=8080 \
    RECYCLENET_MODEL_PATH=/app/models/recyclenet.onnx \
    ORT_DYLIB_PATH=/usr/lib/libonnxruntime.so \
    RUST_LOG=info

# Drop privileges to non-root user
USER appuser

# Expose microservice HTTP port
EXPOSE 8080

# Execute high-performance Rust inference microservice
ENTRYPOINT ["/app/rust_inference"]
